{
  "name": "krealo-shift",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "web": "expo start --web",
    "web:demo": "cross-env EXPO_PUBLIC_DEMO=1 expo start --web",
    "ios": "expo start --ios",
    "android": "expo start --android",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "test": "jest",
    "test:watch": "jest --watch",
    "doctor": "expo-doctor",
    "demo:export": "cross-env EXPO_PUBLIC_DEMO=1 expo export --platform web --output-dir dist-demo --clear",
    "demo:check": "node scripts/demo-check.mjs dist-demo",
    "demo:export:prod": "cross-env EXPO_PUBLIC_DEMO=1 EXPO_PUBLIC_APP_ENV=production expo export --platform web --output-dir dist-demo-prod --clear",
    "demo:check:prod": "node scripts/demo-check.mjs dist-demo dist-demo-prod",
    "web:build": "cross-env EXPO_PUBLIC_APP_ENV=production expo export --platform web --output-dir dist --clear",
    "web:deploy": "npm run web:build && firebase deploy --only hosting",
    "kiosco:check": "node scripts/kiosco-check.mjs dist-demo",
    "reportes:check": "node scripts/reportes-check.mjs dist-demo",
    "inicio:check": "node scripts/inicio-check.mjs dist-demo",
    "tema:check": "node scripts/tema-check.mjs dist-demo",
    "contraste:check": "node scripts/contraste-check.mjs dist-demo"
  },
  "dependencies": {
    "@date-fns/tz": "^1.5.0",
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo/vector-icons": "^15.1.1",
    "@hookform/resolvers": "^5.9.1",
    "@tanstack/react-query": "^5.102.6",
    "bcryptjs": "^3.0.3",
    "date-fns": "^4.4.0",
    "expo": "~57.0.18",
    "expo-application": "~57.0.2",
    "expo-auth-session": "~57.0.12",
    "expo-build-properties": "~57.0.15",
    "expo-camera": "~57.0.4",
    "expo-clipboard": "~57.0.1",
    "expo-constants": "~57.0.15",
    "expo-crypto": "~57.0.2",
    "expo-device": "~57.0.1",
    "expo-file-system": "~57.0.6",
    "expo-font": "~57.0.1",
    "expo-haptics": "~57.0.2",
    "expo-image": "~57.0.3",
    "expo-image-picker": "~57.0.14",
    "expo-keep-awake": "~57.0.1",
    "expo-linking": "~57.0.8",
    "expo-localization": "~57.0.1",
    "expo-network": "~57.0.1",
    "expo-notifications": "~57.0.15",
    "expo-router": "~57.0.17",
    "expo-secure-store": "~57.0.2",
    "expo-sharing": "~57.0.16",
    "expo-splash-screen": "~57.0.8",
    "expo-sqlite": "~57.0.2",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.3",
    "expo-web-browser": "~57.0.3",
    "firebase": "^12.19.0",
    "i18next": "^26.4.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.86.0",
    "react-i18next": "^17.0.12",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-url-polyfill": "^4.0.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1",
    "zod": "^4.4.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.0.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/jest": "29.5.14",
    "@types/node": "^26.4.0",
    "@types/react": "~19.2.2",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "^57.0.2",
    "eslint-config-prettier": "^10.1.8",
    "jest": "^29.7.0",
    "jest-expo": "^57.0.5",
    "prettier": "^3.9.6",
    "react-test-renderer": "^19.2.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.68.0"
  }
}
