rules_version = '2';

// Almacenamiento de Krealo Shift.
//
// Sustituye los dos buckets de Supabase Storage: `attendance-photos` (privado, con
// URLs firmadas) y el logo de la organizacion (lectura publica). Aqui son dos
// prefijos del mismo bucket, con reglas opuestas a proposito.

service firebase.storage {
  match /b/{bucket}/o {

    // LA FOTO DE UN FICHAJE NO SE SIRVE NUNCA DIRECTO. Es la cara de un trabajador
    // en su puesto: retrato identificable, con hora y tienda. Se lee solo por URL
    // firmada de caducidad corta, que emite la Cloud Function tras comprobar que
    // quien la pide gestiona esa ubicacion; y se sube solo desde `attach-photo`,
    // porque el kiosco no tiene sesion personal con la que autenticarse aqui.
    //
    // Dejar esto abierto a `request.auth != null` seria peor que en Supabase: alli
    // el bucket privado obligaba a pasar por la firma. Cerrado significa cerrado.
    match /attendance-photos/{orgId}/{allPaths=**} {
      allow read, write: if false;
    }

    // El logo se muestra en el kiosco, que no tiene sesion: por eso su lectura es
    // publica. La ESCRITURA esta cerrada, y eso es un arreglo del 2026-09-28.
    //
    // Antes esta regla intentaba comprobar «eres administrador de esta empresa» con
    //
    //     exists(/databases/(default)/documents/organization_memberships/...)
    //
    // y LAS REGLAS DE STORAGE NO TIENEN `get()` NI `exists()`: son funciones de las
    // reglas de Firestore, y Storage no puede consultar Firestore. El despliegue
    // acepto la regla con dos advertencias «Invalid function name» que nadie leyo, y
    // en ejecucion llamar a una funcion inexistente hace REVENTAR la condicion.
    // Reventar deniega, asi que subir un logo devolvia `storage/unauthorized` y no
    // funciono nunca desde la migracion de Supabase, donde la politica equivalente si
    // era valida. Lo encontro Andree al intentar poner el logo de su tienda.
    //
    // La comprobacion pasa ahora donde SE PUEDE hacer: la Cloud Function
    // `setOrganizationLogo`, que tiene sesion, Firestore y rol a mano, y escribe con
    // el SDK de administrador, que no pasa por estas reglas. Igual que las fotos de
    // fichaje. Aqui solo queda la lectura.
    match /organization-logos/{orgId}/{fileName} {
      allow read: if true;
      allow write: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
