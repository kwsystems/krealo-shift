# Krealo Shift — variables de entorno de la app (especificación §30)
#
# Copia este archivo a `.env`. A diferencia de la versión anterior, ESTA PLANTILLA
# TRAE LOS VALORES PUESTOS, y eso es correcto: la configuración de Firebase es
# pública por diseño. `apiKey` no es una credencial, es el identificador del
# proyecto ante la API; viaja dentro del paquete web de cualquier forma, y lo que
# protege los datos son las reglas de Firestore y las Cloud Functions.
#
# Lo que NUNCA entra aquí es la clave de cuenta de servicio. No hace falta: las
# funciones se autentican solas dentro de Google, y para los scripts de
# `functions/scripts/` basta con `gcloud auth application-default login`.
#
# `.env` está en .gitignore. Se sigue ignorando para no versionar por accidente una
# variante local apuntando a otro proyecto.

EXPO_PUBLIC_APP_ENV=development

EXPO_PUBLIC_FIREBASE_API_KEY=AIzaSyBM9HCbTlPU3YaYwx8e_tTlHETagCeQrq4
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=krealo-shift.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=krealo-shift
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=krealo-shift.firebasestorage.app
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=577753574972
EXPO_PUBLIC_FIREBASE_APP_ID=1:577753574972:web:dc2eeb274611bf149e9d39

# Entrar con Google en NATIVO (iPad) necesita un cliente OAuth de iOS propio: en web
# no hace falta, porque `signInWithPopup` usa el que Firebase crea solo al habilitar
# el proveedor. Mientras estén vacías, el botón de la app lo dice en pantalla en vez
# de abrir un navegador que acabaría en un error de Google.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

EXPO_PUBLIC_SUPPORT_EMAIL=
EXPO_PUBLIC_PRIVACY_URL=

# Identificador del proyecto en EAS. NO lleva el prefijo EXPO_PUBLIC_ porque solo
# lo usa la configuracion de compilacion, no el cliente. Lo rellena
# `eas build:configure` con el projectId real de la cuenta del propietario; sin el,
# `app.config.ts` deja `extra.eas.projectId` sin definir y la compilacion lo pide.
EAS_PROJECT_ID=
