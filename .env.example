# Krealo Shift — variables de entorno de la app (especificación §30)
#
# Copia este archivo a `.env` y rellena los valores de tu proyecto Supabase.
# `.env` está en .gitignore: NUNCA se commitea.
#
# Solo las variables con prefijo EXPO_PUBLIC_ llegan al cliente, y por eso solo
# pueden contener datos públicos. La clave `service_role` de Supabase NO va aquí:
# se configura como secreto de las Edge Functions en el panel de Supabase.

EXPO_PUBLIC_APP_ENV=development
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_SUPPORT_EMAIL=
EXPO_PUBLIC_PRIVACY_URL=
